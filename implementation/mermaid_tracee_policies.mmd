flowchart TD
    A["User input"] --> B{"Input type"}
    B -->|--policy file or directory| C["cobra.go reads --policy"]
    B -->|--scope and --events| D["cobra.go reads CLI filters"]
    B -->|Kubernetes CRD| E["K8s policy source"]
    C --> F["helper.go"]
    D --> F
    E --> F
    F --> G["policy_file.go validates policy format"]
    G --> H["flags/policy.go builds runtime policies"]
    H --> I["policy.go creates Policy objects"]
    I --> J["policies.go stores policy list and IDs"]
    J --> K["policy_manager.go"]
    K --> L["Select events requested by policies"]
    K --> M["Compute internal dependencies"]
    K --> N["Compute events to emit"]
    K --> O["Compute events to submit"]
    L --> P["policy/ebpf.go"]
    M --> P
    N --> P
    O --> P
    P --> Q["Build eBPF policy maps"]
    Q --> R["events_map"]
    Q --> S["uid/pid/comm filters"]
    Q --> T["namespace/cgroup filters"]
    Q --> U["data filters"]
    Q --> V["policies_config"]
    R --> W["config.go loads config into eBPF"]
    S --> W
    T --> W
    U --> W
    V --> W
    W --> X["eBPF programs start"]
    X --> Y["context.h init_program_data"]
    Y --> Z["Read event_config"]
    Z --> AA["Initialize matched_policies bitmap"]
    AA --> AB["filtering.h match_scope_filters"]
    AB --> AC["filtering.h match_data_filters"]
    AC --> AD{"matched_policies == 0?"}
    AD -->|yes| AE["Drop event in kernel"]
    AD -->|no| AF["Submit event to userspace"]
    AF --> AG["events_pipeline.go decodes event"]
    AG --> AH["events_pipeline.go matchPolicies"]
    AH --> AI{"bitmap still non-zero?"}
    AI -->|no| AJ["Drop event in userspace"]
    AI -->|yes| AK["Convert bitmap to policy names"]
    AK --> AL["types/trace/trace.go"]
    AL --> AM["Output with MatchedPolicies"]